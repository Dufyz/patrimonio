{
  "name": "@patrimonio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm turbo build --filter=@patrimonio/api^... && tsx watch --env-file=../../.env src/cmd/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/cmd/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@patrimonio/application": "workspace:*",
    "@patrimonio/contracts": "workspace:*",
    "@patrimonio/db": "workspace:*",
    "@patrimonio/domain": "workspace:*",
    "@patrimonio/env": "workspace:*",
    "@patrimonio/market": "workspace:*",
    "@patrimonio/queue": "workspace:*",
    "@patrimonio/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
