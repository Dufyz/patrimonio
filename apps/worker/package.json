{
  "name": "@patrimonio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/cmd/worker.ts",
    "start": "node --env-file-if-exists=../../.env dist/cmd/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@patrimonio/application": "workspace:*",
    "@patrimonio/calc": "workspace:*",
    "@patrimonio/db": "workspace:*",
    "@patrimonio/domain": "workspace:*",
    "@patrimonio/env": "workspace:*",
    "@patrimonio/market": "workspace:*",
    "@patrimonio/queue": "workspace:*",
    "@patrimonio/shared": "workspace:*",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
