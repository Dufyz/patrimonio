# Copie para .env. packages/env valida tudo no boot: variável faltando
# derruba o processo nomeando qual, não na primeira requisição que precisar dela.

# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3333
WEB_ORIGIN=http://localhost:5173

# ─── Banco ───────────────────────────────────────────────────────────────────
# Portas do docker-compose: 5433 desenvolvimento, 5434 teste.
DB_CONNECTION=postgres://patrimonio:patrimonio@localhost:5433/patrimonio
DB_TEST_CONNECTION=postgres://patrimonio:patrimonio@localhost:5434/patrimonio_test
DB_POOL_API=10
DB_POOL_WORKER=4

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380
REDIS_TEST_URL=redis://localhost:6380/1

# ─── Pipeline ────────────────────────────────────────────────────────────────
RELAY_POLL_MS=1000
RELAY_BATCH_SIZE=50
DEBOUNCE_MAX_MS=15000

# ─── Mercado (E4; já declarado para o boot não mudar depois) ─────────────────
MARKET_BRAPI_TOKEN=
MARKET_REQUEST_TIMEOUT_MS=10000
PRICE_STALE_AFTER_DAYS=3

# ─── Lançamentos ─────────────────────────────────────────────────────────────
# Janela do desfazer depois de excluir um lançamento: 5, 8 ou 15 segundos.
UNDO_WINDOW_SECONDS=8

# ─── Imposto ─────────────────────────────────────────────────────────────────
# IR retido na fonte em JCP. É lei, e lei muda: fica aqui para o dia em que
# mudar não exigir deploy de código.
JCP_WITHHOLDING_PCT=15

# ─── Backup ──────────────────────────────────────────────────────────────────
# Chave pública do age. A privada fica no gerenciador de senhas, nunca aqui.
BACKUP_PUBLIC_KEY=
BACKUP_BUCKET=backups
BACKUP_STORAGE_URL=
BACKUP_STORAGE_TOKEN=
BACKUP_ENABLED=false
